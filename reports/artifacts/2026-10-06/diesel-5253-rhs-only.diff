+#[diesel_test_helper::test]
+#[cfg(any(feature = "postgres", feature = "sqlite"))]
+fn except_in_subselect_referencing_outer_query() {
+    let conn = &mut connection_with_sean_and_tess_in_users_table();
+
+    insert_into(posts::table)
+        .values(&[
+            (posts::id.eq(1), posts::user_id.eq(1), posts::title.eq("Hello")),
+            (posts::id.eq(2), posts::user_id.eq(1), posts::title.eq("World")),
+            (posts::id.eq(3), posts::user_id.eq(2), posts::title.eq("Other")),
+        ])
+        .execute(conn)
+        .unwrap();
+    insert_into(followings::table)
+        .values(&[
+            (followings::user_id.eq(1), followings::post_id.eq(1), followings::email_notifications.eq(false)),
+            (followings::user_id.eq(1), followings::post_id.eq(2), followings::email_notifications.eq(false)),
+            (followings::user_id.eq(2), followings::post_id.eq(1), followings::email_notifications.eq(false)),
+        ])
+        .execute(conn)
+        .unwrap();
+
+    // Users following every post titled "Hello" or "World"
+    let out = users::table
+        .filter(dsl::not(dsl::exists(
+            posts::table
+                .select(posts::id)
+                .filter(posts::title.eq_any(["Hello", "World"]))
+                .except(
+                    followings::table
+                        .select(followings::post_id)
+                        .filter(followings::user_id.eq(users::id)),
+                ),
+        )))
+        .select(users::name)
+        .load::<String>(conn)
+        .unwrap();
+
+    assert_eq!(out, vec!["Sean"]);
+}
