+/// A query that can be the right hand side of a `UNION`, `INTERSECT` or `EXCEPT`
+///
+/// Unlike [`AsQuery`](crate::query_builder::AsQuery), this does not require the query to be valid on its own:
+/// when the combination is used as a subselect, as with [`exists`](crate::dsl::exists),
+/// its `WHERE` clause may reference the outer query. Loading a combination still
+/// requires both sides to be complete queries.
+pub trait AsCombinationQuery {
+    /// The SQL type of the rows returned by this query
+    type SqlType;
+
+    /// The query that ends up in the combination clause
+    type Query: SelectQuery<SqlType = Self::SqlType>;
+
+    /// Converts `self` into the query that ends up in the combination clause
+    fn as_combination_query(self) -> Self::Query;
+}
+
+impl<T> AsCombinationQuery for T
+where
+    T: QueryRelation,
+    T::Query: SelectQuery,
+{
+    type SqlType = <T::Query as SelectQuery>::SqlType;
+    type Query = T::Query;
+
+    fn as_combination_query(self) -> Self::Query {
+        self.as_query()
+    }
+}
+
+impl<Combinator, Rule, Source, Rhs, O, LOf> AsCombinationQuery
+    for CombinationClause<Combinator, Rule, Source, Rhs, O, LOf>
+where
+    Self: SelectQuery,
+{
+    type SqlType = <Self as SelectQuery>::SqlType;
+    type Query = Self;
+
+    fn as_combination_query(self) -> Self::Query {
+        self
+    }
+}
